{
  "name": "plugin-example",
  "version": "0.0.1",
  "module": "src/server/index.ts",
  "sharkord": {
    "entry": {
      "server": "server/index.js",
      "client": "client/index.js"
    },
    "author": "Me",
    "homepage": "https://some-page.com",
    "description": "This a Sharkord plugin example.",
    "logo": "https://placehold.co/500x500/white/black",
    "sdkRange": "__ignore__"
  },
  "type": "module",
  "bun-create": {
    "preinstall": "echo 'Installing plugin-example...'",
    "postinstall": [
      "echo 'Done. Make sure you have the @sharkord/plugin-sdk AND @sharkord/ui packages linked. Read the docs for more info: https://sharkord.com/docs/plugins/overview'"
    ]
  },
  "scripts": {
    "build": "bun build.ts",
    "build:dev": "bun run build && cp -r dist/* /home/martino/repos/sharkord/apps/server/data/plugins/"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14"
  },
  "peerDependencies": {
    "typescript": "^5",
    "react": "^19",
    "reselect": "^5",
    "re-reselect": "^5"
  }
}
